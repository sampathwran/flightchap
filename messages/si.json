    "description": "\u0db4\u0dca\u0dbb\u0dc1\u0dca\u0db1 \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0daf? \u0d85\u0db4\u0dd2 \u0d9c\u0dcf\u0dc0 \u0d8b\u0dad\u0dca\u0dad\u0dbb \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf.",
    "q1": "\u0dc0\u0da9\u0dcf\u0dad\u0dca \u0dbd\u0dcf\u0db7\u0daf\u0dcf\u0dba\u0dd3 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0d9c\u0db8\u0db1\u0dca \u0dc3\u0ddc\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dda \u0d9a\u0dd9\u0dc3\u0dda\u0daf?",
